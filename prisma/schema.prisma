// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Programme {
  id          String   @id @default(cuid())
  name        String
  description String
  duration    String   // e.g., "6 months", "1 year"
  price       Float
  imageUrl    String?
  curriculum  String   // JSON stringified array of course modules
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations Registration[]

  @@map("programmes")
}

model Registration {
  id              String   @id @default(cuid())
  programmeId     String
  session         String   // e.g., "2024/2025", "Spring 2024", "Fall 2024"

  // Student Information
  firstName       String
  lastName        String
  email           String
  phone           String
  dateOfBirth     DateTime?
  address         String
  city            String
  state           String
  country         String

  // Educational Background
  qualification   String
  institution     String?

  // Email Verification
  emailVerified   Boolean  @default(false)

  // Payment Information
  paymentStatus   String   @default("PENDING")
  amountPaid      Float    @default(0)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  programme       Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@map("registrations")
}

model Payment {
  id              String   @id @default(cuid())
  registrationId  String

  amount          Float
  currency        String   @default("NGN")
  status          String   @default("PENDING")

  // Credo Payment Gateway Fields
  transactionRef  String   @unique
  credoRef        String?
  paymentMethod   String?

  metadata        String?  // JSON stringified additional data

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model EmailVerification {
  id            String   @id @default(cuid())
  email         String
  code          String   // Hashed 6-digit code
  expiresAt     DateTime
  verified      Boolean  @default(false)
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([code])
  @@map("email_verifications")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password
  name      String
  role      String   @default("admin") // admin, superadmin
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("admins")
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  title       String
  bio         String?
  imageUrl    String?
  email       String?
  phone       String?
  department  String?
  linkedin    String?
  twitter     String?
  facebook    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_members")
}

model Enquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  status      String   @default("new") // new, read, replied, archived
  notes       String?  // Internal admin notes
  repliedAt   DateTime?
  repliedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@map("enquiries")
}
