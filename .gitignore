# Dependencies
node_modules/

# Public folder contents (large files)
public/*
!public/.gitignore

# Environment files  
.env

# Logs
logs/
*.log

# OS files
.DS_Store
__MACOSX/

# IDE
.idea/
.vscode/

# Temp files
*.tmp
*.swp
test/

