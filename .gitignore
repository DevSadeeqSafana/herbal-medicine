# Dependencies
node_modules/

# Next.js build output
.next/
out/
tsconfig.tsbuildinfo

# Local SQLite databases (the app uses PostgreSQL via DATABASE_URL)
prisma/**/*.db
prisma/**/*.db-journal

# Public folder contents (large files)
public/*
!public/.gitignore
!public/images/

# Environment files  
.env

# Logs
logs/
*.log

# OS files
.DS_Store
__MACOSX/

# IDE
.idea/
.vscode/

# Temp files
*.tmp
*.swp
test/

# Disposable working scripts and local-only DB safety backups — never meant
# to be committed (may contain raw production data dumps).
scratch/
db-backups/
